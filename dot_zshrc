## Functions

function delete-merged-branches() {
	git checkout master && git branch --merged | grep -v master | xargs git branch -d
}

function update() {
	# brew/mise/npm/gcloud etc. — steps configured in ~/.config/topgrade.toml
	echo '==> topgrade'
	topgrade
	echo '==> dotfiles sync check'
	local dotfiles="$(chezmoi source-path)"
	chezmoi verify || echo '!!> live dotfiles differ from repo, run: chezmoi diff'
	# Prompts before uninstalling anything the Brewfile doesn't declare
	brew bundle cleanup --global
	[[ -n "$(git -C "$dotfiles" status --porcelain)" ]] &&
		echo '!!> dotfiles repo has uncommitted changes'
	[[ -n "$(git -C "$dotfiles" log --oneline '@{upstream}..' 2>/dev/null)" ]] &&
		echo '!!> dotfiles repo has unpushed commits'
	echo '==> done'
	# doom upgrade is deliberately not here: it can break the editor, run it separately
}

# Projects live in ~/.config/proj/projects (kept out of git): a [name] line,
# then one tab directory per line.
function proj() {
	local config="$HOME/.config/proj/projects"
	local name=$1 line current project
	local -a dirs
	if [[ -z $name ]]; then
		sed -n 's/^\[\(.*\)\]$/\1/p' "$config"
		return
	fi
	if [[ $name == all ]]; then
		for project in $(proj); do
			proj "$project" || return
		done
		return
	fi
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line == \[*\] ]]; then
			current=${line:1:-1}
		elif [[ $current == "$name" && -n $line && $line != \#* ]]; then
			dirs+=("${line/#\~/$HOME}")
			# Ghostty silently falls back to another directory for a missing one
			[[ -d ${dirs[-1]} ]] || echo "proj: missing directory ${dirs[-1]}" >&2
		fi
	done <"$config"
	if ((! $#dirs)); then
		echo "proj: no project '$name' in $config" >&2
		return 1
	fi
	# Window ids only survive while Ghostty runs; a stale id just opens a new window
	local state="$HOME/.cache/proj/$name"
	mkdir -p "${state:h}"
	local saved_id="$(cat "$state" 2>/dev/null)"
	osascript - "$saved_id" "${dirs[@]}" >"$state" <<'EOF'
on run argv
	set savedId to item 1 of argv
	set dirs to rest of argv
	tell application "Ghostty"
		activate
		repeat with w in windows
			if id of w is savedId then
				activate window w
				return savedId
			end if
		end repeat
		set cfg to new surface configuration
		set initial working directory of cfg to item 1 of dirs
		set win to new window with configuration cfg
		repeat with d in rest of dirs
			set initial working directory of cfg to contents of d
			new tab in win with configuration cfg
		end repeat
		select tab (tab 1 of win)
		return id of win
	end tell
end run
EOF
}

# Per-repo extra steps: define up_<repo dir name> in ~/.zshrc.local
function up() {
	local root branch
	root=$(git rev-parse --show-toplevel) || return
	if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
		echo "up: uncommitted changes, aborting" >&2
		return 1
	fi
	branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) ||
		{ git remote set-head origin --auto >/dev/null &&
			branch=$(git symbolic-ref --short refs/remotes/origin/HEAD); } || return
	git switch "${branch#origin/}" && git pull --ff-only || return
	local hook="up_${root:t}"
	if typeset -f "$hook" >/dev/null; then
		(cd "$root" && $hook)
	fi
}

# Use colors in ls output
export CLICOLOR=true

# Increase history size
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# Don't save command to history if it starts with a space
setopt HIST_IGNORE_SPACE

# Disable beeping on error
unsetopt beep

# Use Emacs mode in zle (zsh line editor)
bindkey -e

# mise manages node/terraform/python (~/.config/mise/config.toml + per-project
# .node-version/.terraform-version files)
eval "$(mise activate zsh)"

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
# Bash-style completion script, so it's sourced rather than found via fpath
source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc

eval "$(starship init zsh)"
eval "$(atuin init zsh)"
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

_in_pnpm_repo() {
	local dir=$PWD
	while [[ $dir != / ]]; do
		[[ -e $dir/pnpm-lock.yaml ]] && return 0
		dir=${dir:h}
	done
	return 1
}
npm() { if _in_pnpm_repo; then pnpm "$@"; else command npm "$@"; fi; }
npx() { if _in_pnpm_repo; then pnpm exec "$@"; else command npx "$@"; fi; }

# TRANSITION: install the nodenv default-packages list into the current Node
# version (nodenv-default-packages only runs on `nodenv install`).
nodenv-sync-defaults() {
	sed 's/#.*//' "$(nodenv root)/default-packages" | grep -vE '^\s*$' |
		xargs nodenv exec npm install --global
}

export PATH="/opt/homebrew/share/google-cloud-sdk/bin:$PATH"

# Machine-local additions (work aliases etc.) — not managed by chezmoi
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Must stay last: it only highlights widgets defined before it
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
