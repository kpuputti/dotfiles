[user]
	name = Kimmo Puputti
[core]
	editor = emacs -nw
[init]
	defaultBranch = main
[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	updateRefs = true
[diff]
	algorithm = histogram
	colorMoved = plain
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[commit]
	verbose = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true

# Machine-local settings (default git email etc.) — not managed by chezmoi.
# Includes are silently skipped if the file doesn't exist.
[include]
	path = ~/.gitconfig.local

# Personal projects use their own identity (work dir gets the default)
[includeIf "gitdir:~/code/projects/"]
	path = ~/.gitconfig.personal
