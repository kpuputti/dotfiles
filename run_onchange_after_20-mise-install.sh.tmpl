#!/bin/sh
# mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
# default npm packages hash: {{ include "dot_default-npm-packages" | sha256sum }}
set -eu
export PATH="/opt/homebrew/bin:$PATH"
mise install
# mise only installs ~/.default-npm-packages into a newly installed Node, so
# sync the list into the current one as well.
sed 's/#.*//' "$HOME/.default-npm-packages" | grep -vE '^\s*$' |
	xargs mise exec node -- npm install --global
